<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" prefHeight="450.0" prefWidth="600.0"
            style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/25"
            fx:controller="ui.controller.LoginPageController">
    <children>
        <VBox alignment="CENTER" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Text fill="#FF4500" strokeType="OUTSIDE" strokeWidth="0.0" text="Event Manager" textAlignment="CENTER">
                    <font>
                        <Font name="System Bold" size="42.0"/>
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0"/>
                    </VBox.margin>
                </Text>

                <TextField fx:id="loginPageUsernameField" maxWidth="250.0" prefHeight="40.0" promptText="Username"
                           style="-fx-background-color: #F6F7F8; -fx-border-color: #E2E2E2; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 0 15 0 15;">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </TextField>

                <TextField fx:id="loginPagePasswordField" maxWidth="250.0" prefHeight="40.0" promptText="Password"
                           style="-fx-background-color: #F6F7F8; -fx-border-color: #E2E2E2; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 0 15 0 15;">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </TextField>

                <Text fx:id="loginPageInfotextField" fill="#FF4500" strokeType="OUTSIDE" strokeWidth="0.0"
                      textAlignment="CENTER" wrappingWidth="250.0">
                    <font>
                        <Font size="12.0"/>
                    </font>
                </Text>

                <Button fx:id="loginPageLoginButton" mnemonicParsing="false" onAction="#handleLogin" prefHeight="40.0"
                        prefWidth="250.0"
                        style="-fx-background-color: #FF4500; -fx-text-fill: #FFFFFF; -fx-background-radius: 20; -fx-font-weight: bold; -fx-cursor: hand;"
                        text="Login">
                    <font>
                        <Font size="14.0"/>
                    </font>
                    <VBox.margin>
                        <Insets top="5.0"/>
                    </VBox.margin>
                </Button>

                <Button fx:id="loginPageRegisterButton" mnemonicParsing="false" onAction="#handleRegistration"
                        prefHeight="40.0" prefWidth="250.0"
                        style="-fx-background-color: transparent; -fx-border-color: #FF4500; -fx-border-radius: 20; -fx-text-fill: #FF4500; -fx-font-weight: bold; -fx-cursor: hand;"
                        text="Register">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Button>
            </children>
        </VBox>
    </children>
</AnchorPane>
